# Project Management — host terpisah dari mis2.
# Digenerate WAF entrypoint dari /etc/nginx/templates/conf.d/.

server {
    listen 8080;
    server_name pm.banksumut.co.id;

    location / {
        set $pm_tls_redirect ${NGINX_ALWAYS_TLS_REDIRECT};
        if ($pm_tls_redirect = on) {
            return 301 https://$host$request_uri;
        }

        proxy_pass http://pm_app:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
        client_max_body_size 50m;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name pm.banksumut.co.id;

    ssl_certificate     /etc/nginx/conf/server.crt;
    ssl_certificate_key /etc/nginx/conf/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://pm_app:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
        client_max_body_size 50m;
    }
}
