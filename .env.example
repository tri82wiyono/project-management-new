# =============================================================================
# Template only — never commit real credentials.
#
# Local development:
#   cp .env.example .env
#
# Production (VPS):
#   Install secrets OUTSIDE the Git working tree:
#     /etc/banksumut-pms/prod.env   (mode 0600, directory mode 0700)
#   Then:
#     export PM_ENV_FILE=/etc/banksumut-pms/prod.env
#     ./scripts/validate_prod_env.sh "$PM_ENV_FILE"
#     ./scripts/compose_prod.sh up -d --build app
#
# See docs/PRODUCTION_SECURE_CONFIG.md
# =============================================================================

POSTGRES_DB=project_mgmt
POSTGRES_USER=pm_user
POSTGRES_PASSWORD=change_me_strong_db_password
# Local compose host port mapping (optional; not used by docker-compose.prod.yml)
POSTGRES_HOST_PORT=5438

# Port published on the host (app only; DB is not published in prod)
APP_HOST_PORT=8891

# Public application URL (MFA / device-confirm email links)
# Example IP:  http://203.0.113.10:8891
# Example domain + HTTPS: https://pm.banksumut.co.id
APP_URL=https://pm.example.com
APP_NAME=Project Management System

# development = local/dev defaults allowed
# production = reject weak SECRET_KEY / DEFAULT_ADMIN_PASSWORD at startup
# COOKIE_SECURE=true also enables production-like validation
APP_ENV=development

# false in production — must be set explicitly for prod compose
SEED_DATA=false

# Required: long random value, minimum 32 characters. Never use real prod values here.
SECRET_KEY=change_me_to_a_long_random_secret_at_least_32_chars

# Optional explicit DB URL (prod compose builds DATABASE_URL from POSTGRES_*).
# DATABASE_URL=postgresql+psycopg2://pm_user:change_me_strong_db_password@localhost:5438/project_mgmt

# true when served over HTTPS (reverse proxy / Cloudflare)
COOKIE_SECURE=false

# Private file storage (tickets/projects). Must NOT be under /static.
UPLOAD_DIR=/app/data/uploads

# Phase 4 — organizational Project/Task scope enforcement.
# Keep false for initial production release until classification is complete.
ORG_SCOPE_ENFORCEMENT=false

DEFAULT_ADMIN_EMAIL=admin@example.com
# Bootstrap only when the admin user is first created — not the live account rotator.
# Minimum 12 characters; never use real production values in this template.
DEFAULT_ADMIN_PASSWORD=change_me_strong_admin_password
DEFAULT_ADMIN_NAME=System Admin
