# Salin ke .env lalu sesuaikan untuk VPS
# cp .env.example .env

POSTGRES_DB=project_mgmt
POSTGRES_USER=pm_user
POSTGRES_PASSWORD=ganti_password_db_yang_kuat

# Port yang dibuka di VPS (app saja; DB tidak diexpose di prod)
APP_HOST_PORT=8891

# URL publik aplikasi (penting untuk email MFA/device confirm)
# Contoh IP:  http://203.0.113.10:8891
# Contoh domain + HTTPS: https://pm.banksumut.co.id
APP_URL=https://pm.banksumut.co.id
APP_NAME=Project Management System

# development = local/dev defaults allowed
# production = reject weak SECRET_KEY / DEFAULT_ADMIN_PASSWORD at startup
# COOKIE_SECURE=true also enables production-like validation
APP_ENV=production

# false di production agar tidak mengisi data demo
SEED_DATA=false

# Wajib diganti (acak panjang, minimal 32 karakter). Jangan pakai placeholder.
SECRET_KEY=ganti_dengan_string_acak_panjang_minimal_32_karakter

# true jika akses via HTTPS (reverse proxy / Cloudflare)
COOKIE_SECURE=true

# Private file storage (tickets/projects). Must NOT be under /static.
UPLOAD_DIR=/app/data/uploads

DEFAULT_ADMIN_EMAIL=admin@banksumut.co.id
# Wajib diganti di production (minimal 12 karakter, bukan placeholder)
DEFAULT_ADMIN_PASSWORD=ganti_password_admin
DEFAULT_ADMIN_NAME=System Admin
